# Telegram
TG_BOT_TOKEN=your-bot-token-from-botfather
# Comma-separated Telegram user IDs allowed to talk to the bot (owner first)
TG_ALLOWED_IDS=123456789
# Default LLM
PROVIDER=openai            # openai | deepseek | groq | openrouter | google | anthropic | local
MODEL=gpt-4o
API_KEY=                    # fallback key for the default provider
# Per-provider keys (optional, used by /set-api-key / provider switching)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
# Local (Ollama / vLLM / LM Studio)
LOCAL_BASE_URL=http://localhost:11434/v1
# Generators
FAL_KEY=                    # for video/image gen via fal.ai (optional)
EDGE_TTS=on                 # fallback TTS without OpenAI key
